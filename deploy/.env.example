# ORBIT production env — copy to `.env` on the VPS and fill in real values.
# NEVER commit the real .env. (deploy/.env is gitignored.)

# --- Postgres (pick a strong password) ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=orbit_protocol

# --- Stellar (Testnet for the Instaward) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Deployed contract IDs (from .env.testnet) ---
AGENT_REGISTRY_CONTRACT_ID=CBGROUBL3CAOXD6WXZDJKZJQ7PWJOJSGXZSFNENBNRIMZ4HG6BNT6CJF
VERIFICATION_CONTRACT_ID=CAVCJ2UMXMYMAJN7YNQ4RNBQ4SXFCV36QRGZWSHXVEK2CX7UG42LEVN5
REPUTATION_CONTRACT_ID=CAS4TMQYODZGN3OL2LC4KNLESHTDP6V5DY2ZEVZRBBQQXDUX665AQOFM
PASSPORT_CONTRACT_ID=CBD4LGX2FCZO7G2MOD6DWURS3RMVIQR3WYAK3RRWYOU5M2U7TF27VT3B
MULTI_WALLET_CONTRACT_ID=CAXKMS46TYZH5HENW7BSUT3VQ3SP4CA7BNIRQHH6NFSI62Q4KTXPPHY3

# --- Frontend build-time (baked into the bundle) ---
# api.orbitprotocol.dev is routed to the api container by the Cloudflare Tunnel.
NEXT_PUBLIC_API_URL=https://api.orbitprotocol.dev
NEXT_PUBLIC_STELLAR_NETWORK=testnet
